{
  "manifest_version": 3,
  "name": "Fabushi Computer Control Bridge",
  "version": "0.1.0",
  "description": "Let your local Fabushi Computer Control service securely discover and claim signed-in Chrome tabs.",
  "permissions": ["alarms", "debugger", "downloads", "nativeMessaging", "storage", "tabGroups", "tabs", "webNavigation"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Fabushi Computer Control status",
    "default_popup": "popup.html"
  }
}
