{
  "manifest_version": 3,
  "name": "Fabushi",
  "short_name": "Fabushi",
  "version": "0.6.0",
  "minimum_chrome_version": "120",
  "description": "Fabushi for Chrome — your Fabushi workspace and a secure bridge between the desktop app and the browser you already use.",
  "permissions": [
    "alarms",
    "debugger",
    "downloads",
    "nativeMessaging",
    "scripting",
    "storage",
    "tabGroups",
    "tabs",
    "userScripts",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["userscript-content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Fabushi",
    "default_popup": "app.html"
  }
}
